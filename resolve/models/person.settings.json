    {
      "comparison_description": "CustomComparison",
      "comparison_levels": [
        {
          "fix_m_probability": false,
          "fix_u_probability": false,
          "is_null_level": true,
          "label_for_charts": "name_key is NULL",
          "sql_condition": "\"name_key_l\" IS NULL OR \"name_key_r\" IS NULL"
        },
        {
          "fix_m_probability": false,
          "fix_u_probability": false,
          "label_for_charts": "name key equal",
          "sql_condition": "\"name_key_l\" = \"name_key_r\"",
          "tf_adjustment_column": "name_key",
          "tf_adjustment_weight": 1.0
        },
        {
          "fix_m_probability": false,
          "fix_u_probability": false,
          "label_for_charts": "forename and surname similar",
          "sql_condition": "(jaro_winkler_similarity(\"forename_l\", \"forename_r\") >= 0.92) AND (jaro_winkler_similarity(\"surname_l\", \"surname_r\") >= 0.92)"
        },
        {
          "fix_m_probability": false,
          "fix_u_probability": false,
          "label_for_charts": "surname equal, same initial",
          "sql_condition": "(\"surname_l\" = \"surname_r\") AND (\"initial_l\" = \"initial_r\")"
        },
        {
          "fix_m_probability": false,
          "fix_u_probability": false,
          "label_for_charts": "two name symbols shared",
          "sql_condition": "array_length(list_intersect(\"name_symbols_l\", \"name_symbols_r\")) >= 2"
        },
        {
          "fix_m_probability": false,
          "fix_u_probability": false,
          "label_for_charts": "name key similar",
          "sql_condition": "jaro_winkler_similarity(\"name_key_l\", \"name_key_r\") >= 0.88"
        },
        {
          "fix_m_probability": false,
          "fix_u_probability": false,
          "label_for_charts": "surname equal",
          "sql_condition": "\"surname_l\" = \"surname_r\""
        },
        {
          "fix_m_probability": false,
          "fix_u_probability": false,
          "label_for_charts": "two skeletons shared",
          "sql_condition": "array_length(list_intersect(\"skeletons_l\", \"skeletons_r\")) >= 2"
        },
        {
          "fix_m_probability": false,
          "fix_u_probability": false,
          "label_for_charts": "All other comparisons",
          "sql_condition": "ELSE"
        }
