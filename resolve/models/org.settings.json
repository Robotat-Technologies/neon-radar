{
  "additional_columns_to_retain": [],
  "blocking_rules_to_generate_predictions": [
    {
      "blocking_rule": "(l.\"name_key\" = r.\"name_key\") AND (l.\"synthetic\" = r.\"synthetic\")",
      "sql_dialect": "duckdb"
    },
    {
      "blocking_rule": "(l.\"ch_same_as\" = r.\"ch_same_as\") AND (l.\"synthetic\" = r.\"synthetic\")",
      "sql_dialect": "duckdb"
    },
    {
      "arrays_to_explode": [
        "registration_numbers"
      ],
      "blocking_rule": "(l.\"registration_numbers\" = r.\"registration_numbers\") AND (l.\"synthetic\" = r.\"synthetic\")",
      "sql_dialect": "duckdb"
    },
    {
      "arrays_to_explode": [
        "aliases"
      ],
      "blocking_rule": "(l.\"aliases\" = r.\"aliases\") AND (l.\"synthetic\" = r.\"synthetic\")",
      "sql_dialect": "duckdb"
    },
    {
      "blocking_rule": "(l.\"postcode\" = r.\"postcode\") AND (l.\"name_prefix\" = r.\"name_prefix\") AND (l.\"synthetic\" = r.\"synthetic\")",
      "sql_dialect": "duckdb"
    }
  ],
  "comparison_vector_value_column_prefix": "gamma_",
  "comparisons": [
    {
      "comparison_description": "CustomComparison",
      "comparison_levels": [
        {
          "fix_m_probability": false,
          "fix_u_probability": false,
          "is_null_level": true,
          "label_for_charts": "name_key is NULL",
          "sql_condition": "\"name_key_l\" IS NULL OR \"name_key_r\" IS NULL"
        },
        {
          "fix_m_probability": false,
          "fix_u_probability": false,
          "label_for_charts": "name key equal",
          "sql_condition": "\"name_key_l\" = \"name_key_r\"",
          "tf_adjustment_column": "name_key",
          "tf_adjustment_weight": 1.0
        },
        {
          "fix_m_probability": false,
          "fix_u_probability": false,
          "label_for_charts": "a name or alias shared",
          "sql_condition": "array_length(list_intersect(\"aliases_l\", \"aliases_r\")) >= 1"
        },
        {
          "fix_m_probability": false,
          "fix_u_probability": false,
          "label_for_charts": "same name under the Companies House rules",
          "sql_condition": "\"ch_same_as_l\" = \"ch_same_as_r\""
        },
        {
          "fix_m_probability": false,
          "fix_u_probability": false,
          "label_for_charts": "name key very similar",
          "sql_condition": "jaro_winkler_similarity(\"name_key_l\", \"name_key_r\") >= 0.95"
        },
        {
          "fix_m_probability": false,
          "fix_u_probability": false,
          "label_for_charts": "name key similar",
          "sql_condition": "jaro_winkler_similarity(\"name_key_l\", \"name_key_r\") >= 0.88"
        },
        {
          "fix_m_probability": false,
          "fix_u_probability": false,
          "label_for_charts": "two words shared",
          "sql_condition": "array_length(list_intersect(\"name_tokens_l\", \"name_tokens_r\")) >= 2"
        },
        {
          "fix_m_probability": false,
          "fix_u_probability": false,
          "label_for_charts": "All other comparisons",
          "sql_condition": "ELSE"
        }
      ],
      "output_column_name": "org_name"
    },
    {
