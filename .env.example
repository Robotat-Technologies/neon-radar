# Copy to .env and fill in. .env is gitignored. Never commit it.
NEO4J_PASSWORD=change-me-to-something-long
# Memory profile "standard" (16 GB laptop). For "small" (8 GB laptop) use:
#   NEO4J_HEAP=1G  NEO4J_PAGECACHE=512M  NEO4J_MEM_LIMIT=2500m
NEO4J_HEAP=2G
NEO4J_PAGECACHE=2G
NEO4J_MEM_LIMIT=5g
NEO4J_URI=bolt://localhost:7687
# Host ports on 127.0.0.1 (defaults shown). If you move the Bolt port, change NEO4J_URI too.
#   NEO4J_HTTP_PORT=7474  NEO4J_BOLT_PORT=7687  NR_API_PORT=8000  NR_UI_PORT=8080
NEO4J_USER=neo4j
# Companies House API key: only for the companies-house spike and loader
CH_API_KEY=
# Real-data instance neo4j-real (PHASE-2.md 1.1, 4.1). NR_NEO4J_REAL_URI is the default; set
# NEO4J_REAL_PASSWORD only on a machine listed in docs/data/real-data-machines.md.
NR_NEO4J_REAL_URI=bolt://127.0.0.1:7688
NEO4J_REAL_PASSWORD=
# Set to approved only on a machine the data steward listed in docs/data/real-data-machines.md
NR_REAL_DATA_MACHINE=
