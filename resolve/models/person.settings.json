{
  "additional_columns_to_retain": [],
  "blocking_rules_to_generate_predictions": [
    {
      "blocking_rule": "(l.\"surname\" = r.\"surname\") AND (l.\"birth_year_min\" = r.\"birth_year_min\") AND (l.\"synthetic\" = r.\"synthetic\")",
      "sql_dialect": "duckdb"
    },
    {
      "blocking_rule": "(l.\"forename\" = r.\"forename\") AND (l.\"birth_ym_min\" = r.\"birth_ym_min\") AND (l.\"synthetic\" = r.\"synthetic\")",
      "sql_dialect": "duckdb"
    },
    {
      "blocking_rule": "(l.\"postcode\" = r.\"postcode\") AND (SUBSTRING(l.surname, 1, 1) = SUBSTRING(r.surname, 1, 1)) AND (l.\"synthetic\" = r.\"synthetic\")",
      "sql_dialect": "duckdb"
    },
    {
      "arrays_to_explode": [
        "linked_orgs"
      ],
      "blocking_rule": "(l.\"linked_orgs\" = r.\"linked_orgs\") AND (l.\"synthetic\" = r.\"synthetic\")",
      "sql_dialect": "duckdb"
    },
    {
      "arrays_to_explode": [
        "name_symbols"
      ],
      "blocking_rule": "(l.\"name_symbols\" = r.\"name_symbols\") AND (l.\"birth_year_min\" = r.\"birth_year_min\") AND (l.\"synthetic\" = r.\"synthetic\")",
      "sql_dialect": "duckdb"
    },
    {
      "blocking_rule": "(l.\"name_key_rare\" = r.\"name_key_rare\") AND (l.\"synthetic\" = r.\"synthetic\")",
      "sql_dialect": "duckdb"
    }
  ],
