{
  "$defs": {
    "Counts": {
      "additionalProperties": false,
      "properties": {
        "by_schema": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "By Schema",
          "type": "object"
        },
        "skipped": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Skipped",
          "type": "object"
        }
      },
      "required": [
        "by_schema",
        "skipped"
      ],
      "title": "Counts",
      "type": "object"
    },
    "ManifestFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "records": {
          "minimum": 0,
          "title": "Records",
          "type": "integer"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "records"
      ],
      "title": "ManifestFile",
      "type": "object"
    },
    "ManifestLicence": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Attribution"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "attribution"
      ],
      "title": "ManifestLicence",
      "type": "object"
    },
    "Producer": {
      "additionalProperties": false,
      "properties": {
        "git_sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Sha"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "Producer",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "retrieved_at": {
          "anyOf": [
            {
              "maxLength": 20,
              "minLength": 20,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version"
        },
        "urls": {
          "items": {
            "type": "string"
          },
          "title": "Urls",
          "type": "array"
        }
      },
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The `*.manifest.json` that sits next to every `.ftm.jsonl` file (5.1).\n\n`dataset`, `licence.id` and `synthetic` must agree with contracts/datasets.yaml.",
  "properties": {
    "counts": {
      "$ref": "#/$defs/Counts"
    },
    "created_at": {
      "maxLength": 20,
      "minLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Created At",
      "type": "string"
    },
    "dataset": {
      "minLength": 1,
      "title": "Dataset",
      "type": "string"
    },
    "dependencies": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Dependencies",
      "type": "object"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/ManifestFile"
      },
      "minItems": 1,
      "title": "Files",
      "type": "array"
    },
    "licence": {
      "$ref": "#/$defs/ManifestLicence"
    },
    "manifest_version": {
      "const": "1.0",
      "title": "Manifest Version",
      "type": "string"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "record_contract": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Record Contract",
      "type": "string"
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "synthetic": {
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "manifest_version",
    "record_contract",
    "dataset",
    "files",
    "created_at",
    "producer",
    "source",
    "licence",
    "counts",
    "dependencies",
    "synthetic"
  ],
  "title": "Manifest",
  "type": "object"
}
